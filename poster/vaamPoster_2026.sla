        <PAGEOBJECT XPOS="186.87530992836" YPOS="2157.8988976378" OwnPage="0" ItemID="978901055" PTYPE="4" WIDTH="1119" HEIGHT="516.101102362204" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" TEXTFLOWMODE="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="0" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L1119 0 L1119 516.101 L0 516.101 L0 0 Z" copath="M0 0 L1119 0 L1119 516.101 L0 516.101 L0 0 Z" gXpos="11.1570800070999" gYpos="211.30992125985" gWidth="1232.54377292048" gHeight="727.411023622054" PSTYLE="listBox" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="listBox" ALIGN="0" CPARENT="textBodiesPoster"/>
                <ITEXT FONTSIZE="30" CH="Saplings with reduced fungal microbiomes (M-) and naturally assembled microbiomes (M+) will be raised at Uni-Bayreuth."/>
                <para ALIGN="0"/>
                <ITEXT FONTSIZE="30" CH="Saplings will be placed in (+/-) gap treatments at FOX sites and nearby grassland EPs. "/>
                <para ALIGN="0"/>
                <ITEXT FONTSIZE="30" CH="The heterogeneity in site conditions across and within BEs will act as climatic treatments."/>
                <para ALIGN="0"/>
                <ITEXT FONTSIZE="30" CH="Phyllosphere mycobiomes of all saplings and adjacent adult trees will be surveyed using metabarcoding."/>
                <para ALIGN="0"/>
                <ITEXT FONTSIZE="30" CH="Data will be synthesized using source tracking models and joint species distribution models (JSDM) of fungi, and general linear models of end-of-season sapling health."/>
                <trail ALIGN="0"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="213.386456692914" YPOS="1795.49965984252" OwnPage="0" ItemID="979343791" PTYPE="4" WIDTH="1043.48851307797" HEIGHT="205.500340157479" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="0" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L1043.49 0 L1043.49 205.5 L0 205.5 L0 0 Z" copath="M0 0 L1043.49 0 L1043.49 205.5 L0 205.5 L0 0 Z" gXpos="213.386456692918" gYpos="1795.49965984252" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FONTSIZE="30" CH="Forest trees are facing rapidly shifting habitat conditions and disturbance regimes.  We will investigate the importance of the forest fungal microbiome in resilience of saplings in field conditions, and the importance of the forest canopy for the assembly of microbiomes associated with healthy trees."/>
                <trail ALIGN="0" LINESP="33"/>
            </StoryText>
        </PAGEOBJECT>
