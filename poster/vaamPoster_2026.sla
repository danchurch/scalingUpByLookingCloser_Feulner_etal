                <ITEXT CH="attemped culturing of all "/>
                <ITEXT FONT="DejaVu Sans Mono Oblique" CH="Nostoc"/>
                <ITEXT CH="-like organisms"/>
                <para PARENT="listBox"/>
                <ITEXT CH="chemical surface sterilization for detection of endophytes"/>
