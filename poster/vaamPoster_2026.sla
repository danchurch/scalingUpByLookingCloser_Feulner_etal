            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Field surveys for "/>
                <ITEXT FONT="DejaVu Sans Mono Oblique" CH="Nostoc"/>
                <ITEXT CH="-like colonies in mosses, especially rare arboreal mosses"/>
                <para PARENT="listBox"/>
                <ITEXT CH="Light and epi-fluorescence microscopy "/>
